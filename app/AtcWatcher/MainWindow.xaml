<Window x:Class="AtcWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtcWatcher"
        Title="ATC Watcher for MSFS 2024" Width="760" Height="860" MinWidth="640" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <local:VerdictBrushConverter x:Key="VerdictBrush"/>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ATC Watcher" FontSize="24" FontWeight="Bold"/>
        <TextBlock x:Name="StatusText" Text="Starting…" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
      </StackPanel>
      <Button x:Name="ArmButton" Grid.Column="1" Click="ArmButton_Click" Width="170" Height="52" FontSize="16" FontWeight="Bold"
              Margin="0" Background="{StaticResource Green}" BorderBrush="{StaticResource Green}" Content="ARMED"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 1. Panel -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="1. Where is the ATC panel?" Style="{StaticResource H2}"/>
            <TextBlock x:Name="RegionText" Text="Not set yet." Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FindButton" Style="{StaticResource Primary}" Content="Find it for me" Click="FindButton_Click"/>
              <Button Content="Select manually" Click="SelectButton_Click"/>
              <Button x:Name="TestButton" Content="Test now" Click="TestButton_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                       Text="Open the ATC panel in the sim and pin it so it stays on screen, then click “Find it for me”. It looks for the numbered replies on every monitor."/>
          </StackPanel>
        </Border>

        <!-- 2. Callsign -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="2. Your callsign" Style="{StaticResource H2}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CallsignBox" LostFocus="CallsignBox_LostFocus" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="Detect from panel" Click="DetectCallsign_Click" Margin="0"/>
            </Grid>
            <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                       Text="For example N172SP or Speedbird NAO9210. Replies that contain your callsign are treated as read-backs."/>
          </StackPanel>
        </Border>

        <!-- Live view -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="What it sees right now" Style="{StaticResource H2}"/>
            <ListView x:Name="OptionsList" Height="150">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Number}"/>
                  <GridViewColumn Header="Action" Width="80">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Reply text" Width="340" DisplayMemberBinding="{Binding Text}"/>
                  <GridViewColumn Header="Why" Width="220" DisplayMemberBinding="{Binding Reason}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock x:Name="LiveHint" Style="{StaticResource Dim}" Margin="0,8,0,0" Text="PRESS = it will answer this. DENY = never pressed. SKIP = no rule matched."/>
          </StackPanel>
        </Border>

        <!-- History -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Calls it answered" Style="{StaticResource H2}"/>
            <ListView x:Name="HistoryList" Height="140">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Time}"/>
                  <GridViewColumn Header="Reply" Width="420" DisplayMemberBinding="{Binding Text}"/>
                  <GridViewColumn Header="Key" Width="40" DisplayMemberBinding="{Binding Key}"/>
                  <GridViewColumn Header="" Width="110">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Screenshot" Padding="8,2" Margin="0" FontSize="11" Tag="{Binding Path}" Click="ViewCapture_Click"
                                Visibility="{Binding HasPath}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Style="{StaticResource CardStyle}">
          <Expander Header="Advanced settings" IsExpanded="False">
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Check the panel every (seconds)" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Margin="0,3" LostFocus="Advanced_LostFocus"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" Text="10 is plenty. ATC waits well over 20 s before it minds."/>

              <TextBlock Grid.Row="1" Text="Minimum gap between key presses (s)" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinGapBox" Margin="0,3" LostFocus="Advanced_LostFocus"/>

              <TextBlock Grid.Row="2" Text="Arm / disarm hotkey" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyBox" Margin="0,3" LostFocus="Advanced_LostFocus"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Works from inside the sim. Example: ctrl+alt+a"/>

              <TextBlock Grid.Row="3" Text="Only press when window title contains" VerticalAlignment="Center"/>
              <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TitleBox" Margin="0,3" LostFocus="Advanced_LostFocus"/>

              <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="DryRunBox" Content="Practice mode (log only, never press keys)" Click="Advanced_LostFocus"/>
                <CheckBox x:Name="StartMinBox" Content="Start in the tray" Click="Advanced_LostFocus"/>
                <CheckBox x:Name="AutostartBox" Content="Launch with Windows" Click="Autostart_Click"/>
              </StackPanel>

              <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Edit reply rules (settings.json)" Click="EditRules_Click"/>
                <Button Content="Reset rules to defaults" Click="ResetRules_Click"/>
                <Button Content="Open log &amp; screenshots folder" Click="OpenFolder_Click"/>
              </StackPanel>
              <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Dim}" Margin="0,10,0,0"
                         Text="Rules and key bindings live in settings.json. Changes to the file are picked up when you click “Reload rules” or restart."/>
              <Button Grid.Row="7" Grid.ColumnSpan="3" Content="Reload rules from file" Click="ReloadRules_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </Grid>
          </Expander>
        </Border>

        <!-- Log -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Activity log" Style="{StaticResource H2}"/>
            <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,0,0,8"
                   Text="Closing this window keeps ATC Watcher running in the tray. Use the tray icon to exit."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>

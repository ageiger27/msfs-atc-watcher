<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AtcWatcher</RootNamespace>
    <AssemblyName>AtcWatcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Authors>Andrew Geiger</Authors>
    <Product>ATC Watcher for MSFS 2024</Product>
    <Description>Answers routine ATC calls in MSFS 2024 career mode while you are away from the keyboard.</Description>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtcWatcher.Core\AtcWatcher.Core.csproj" />
  </ItemGroup>

</Project>
